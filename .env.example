# ============================================
# ReviewASN - contoh konfigurasi environment
# ============================================
# Cara pakai:
#   1. Salin file ini menjadi ".env" (tanpa .example)
#      cp .env.example .env        (Linux/Mac)
#      copy .env.example .env      (Windows)
#   2. Isi nilainya.
#   3. JANGAN bagikan file .env yang sudah diisi!
#      (.env sudah masuk daftar .gitignore)
#
# Catatan format:
#   - KEY=VALUE, satu variabel per baris
#   - Baris kosong / awalan # diabaikan
#   - Tanda kutip opsional: KEY="nilai" atau KEY='nilai'
#   - Variabel di environment sistem menang atas isi .env

# --------------------------------------------
# Token bot Telegram (wajib untuk --telegram / --all)
# Buat bot via @BotFather di Telegram -> /newbot -> salin tokennya
# Contoh: 123456789:AAHfLx...contoh-token
# --------------------------------------------
TELEGRAM_TOKEN=123456789:AAGI-masukkan-token-dari-BotFather-disini

# --------------------------------------------
# User ID Telegram yang boleh memakai bot (disarankan diisi!)
# Daftar ID dipisah koma. Contoh: 346120845,123456789
# Cara cek ID: kirim pesan ke bot lalu lihat log, atau pakai @userinfobot
# Kosong = SEMUA user bisa memakai bot (tidak disarankan)
# --------------------------------------------
TG_IZIN=346120845
